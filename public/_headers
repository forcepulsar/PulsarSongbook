# Ported from public/.htaccess for Cloudflare Workers static assets.
# Vite copies this file into dist/; Workers parses it and never serves it.
#
# Deliberately NOT ported from .htaccess:
#   - HTTP->HTTPS redirect: use the zone's "Always Use HTTPS" setting.
#   - SPA fallback rewrite: wrangler.jsonc not_found_handling handles it.
#     (_redirects cannot do internal rewrites, only redirects.)
#   - gzip/DEFLATE: Cloudflare compresses responses automatically.

# Content-hashed build output: safe to cache forever. Workers' default is
# "public, max-age=0, must-revalidate", so this must be set explicitly.
# CORS was <FilesMatch "\.(ttf|woff2|svg|...)"> Header set A-C-A-O "*".
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Non-hashed static images (was: ExpiresByType image/* "access plus 1 year")
/icons/*
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *

/screenshots/*
  Cache-Control: public, max-age=31536000

# PWA plumbing must never be cached long, or clients pin to a stale build.
# index.html and /legacy/* stay on the Workers default, which is correct.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/registerSW.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
